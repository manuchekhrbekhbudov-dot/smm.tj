generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  SMM_SPECIALIST
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

model User {
  id               String     @id @default(cuid())

  firstName        String
  lastName         String

  username         String     @unique
  phone            String     @unique
  email            String?    @unique

  passwordHash     String

  role             Role       @default(CLIENT)
  status           UserStatus @default(ACTIVE)

  region           String?
  city             String?

  businessType     String?

  avatarUrl        String?

  isVerified       Boolean    @default(false)

  refreshTokenHash String?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([role])
  @@index([status])
  @@index([region])
  @@index([city])
  @@index([createdAt])
}
