* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #050507;
    color: #ffffff;
    overflow-x: hidden;
}

button,
a {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}

/* =========================
   BACKGROUND
========================= */

.bg-glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: #7c3cff;
    filter: blur(180px);
    opacity: 0.13;
    pointer-events: none;
    z-index: -1;
    animation: glowMove 8s ease-in-out infinite alternate;
}

.glow-one {
    top: -200px;
    left: -150px;
}

.glow-two {
    right: -200px;
    bottom: 10%;
    animation-delay: 2s;
}

@keyframes glowMove {
    from {
        transform: translate(0, 0) scale(1);
    }

    to {
        transform: translate(100px, 70px) scale(1.2);
    }
}

/* =========================
   HEADER
========================= */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;

    width: 100%;
    min-height: 78px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 6%;

    background: rgba(5, 5, 7, 0.78);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

.logo {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -1px;
}

.logo span {
    color: #9b5cff;
}

.nav {
    display: flex;
    align-items: center;
    gap: 32px;
}

.nav a {
    position: relative;

    color: #a7a7b0;
    font-size: 14px;
    transition: 0.3s ease;
}

.nav a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -8px;

    width: 0;
    height: 2px;

    background: #9b5cff;

    transition: 0.3s ease;
}

.nav a:hover {
    color: white;
}

.nav a:hover::after {
    width: 100%;
}

.header-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
}

.login-btn,
.register-btn {
    border: none;
    border-radius: 12px;
    padding: 11px 18px;
    transition: 0.3s ease;
}

.login-btn {
    background: transparent;
    color: #ffffff;
}

.login-btn:hover {
    background: rgba(255, 255, 255, 0.06);
}

.register-btn {
    color: white;
    background: linear-gradient(135deg, #7c3cff, #a45cff);
    box-shadow: 0 0 25px rgba(139, 72, 255, 0.25);
}

.register-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 35px rgba(139, 72, 255, 0.35);
}

.menu-btn {
    display: none;

    border: none;
    background: transparent;
    color: white;
    font-size: 25px;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 720px;

    max-width: 1400px;
    margin: auto;

    padding: 100px 6%;

    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 80px;
}

.hero-content {
    animation: heroIn 1s ease forwards;
}

@keyframes heroIn {
    from {
        opacity: 0;
        transform: translateY(40px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero-badge {
    width: fit-content;

    display: flex;
    align-items: center;
    gap: 10px;

    padding: 9px 14px;

    border: 1px solid rgba(155, 92, 255, 0.25);
    border-radius: 50px;

    background: rgba(155, 92, 255, 0.08);

    color: #c8b0ff;
    font-size: 13px;

    margin-bottom: 25px;
}

.hero-badge span,
.online span {
    width: 8px;
    height: 8px;

    border-radius: 50%;
    background: #9b5cff;

    box-shadow: 0 0 15px #9b5cff;

    animation: pulse 1.8s infinite;
}

@keyframes pulse {
    0% {
        transform: scale(1);
        opacity: 1;
    }

    50% {
        transform: scale(1.5);
        opacity: 0.5;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.hero h1 {
    max-width: 800px;

    font-size: clamp(45px, 5vw, 76px);
    line-height: 0.98;
    letter-spacing: -3px;

    margin-bottom: 25px;
}

.hero h1 span {
    background: linear-gradient(90deg, #8f4fff, #d2b3ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.hero p {
    max-width: 650px;

    color: #94949e;
    font-size: 17px;
    line-height: 1.7;

    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
}

.primary-btn,
.ai-btn {
    border: none;
    border-radius: 14px;

    padding: 15px 22px;

    color: white;
    font-weight: 700;

    transition: 0.3s ease;
}

.primary-btn {
    background: linear-gradient(135deg, #7638ff, #a45cff);
    box-shadow: 0 0 30px rgba(139, 72, 255, 0.25);
}

.primary-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(139, 72, 255, 0.4);
}

.ai-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
}

.ai-btn:hover {
    background: rgba(155, 92, 255, 0.1);
    border-color: rgba(155, 92, 255, 0.4);
    transform: translateY(-4px);
}

.hero-stats {
    display: flex;
    gap: 45px;
    margin-top: 55px;
}

.stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.stat strong {
    font-size: 27px;
}

.stat span {
    color: #777780;
    font-size: 13px;
}

/* =========================
   AI CARD
========================= */

.hero-card {
    position: relative;

    padding: 30px;

    border-radius: 28px;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.075),
            rgba(255, 255, 255, 0.025)
        );

    border: 1px solid rgba(255, 255, 255, 0.1);

    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 30px 100px rgba(0, 0, 0, 0.5),
        0 0 80px rgba(124, 60, 255, 0.08);

    animation: floating 5s ease-in-out infinite;
}

@keyframes floating {
    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}

.hero-card::before {
    content: "";

    position: absolute;
    inset: -1px;

    border-radius: inherit;

    background: linear-gradient(
        135deg,
        rgba(155, 92, 255, 0.4),
        transparent 35%,
        transparent 70%,
        rgba(155, 92, 255, 0.2)
    );

    z-index: -1;
}

.card-top {
    display: flex;
    align-items: center;
    gap: 14px;

    padding-bottom: 25px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.ai-icon {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border-radius: 15px;

    background: rgba(155, 92, 255, 0.13);

    font-size: 23px;
}

.card-top small {
    display: block;
    color: #85858f;
    margin-bottom: 3px;
}

.card-top h3 {
    font-size: 17px;
}

.online {
    margin-left: auto;
}

.ai-message {
    margin: 25px 0;

    padding: 17px;

    border-radius: 16px;

    background: rgba(155, 92, 255, 0.08);
    border: 1px solid rgba(155, 92, 255, 0.12);

    color: #d4d4db;

    line-height: 1.6;
}

.ai-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.ai-options button {
    border: 1px solid rgba(255, 255, 255, 0.07);

    border-radius: 12px;

    padding: 13px;

    background: rgba(255, 255, 255, 0.035);

    color: #c7c7cf;

    transition: 0.3s ease;
}

.ai-options button:hover {
    background: rgba(155, 92, 255, 0.13);
    border-color: rgba(155, 92, 255, 0.4);
    color: white;
    transform: translateY(-3px);
}

.card-ai-btn {
    width: 100%;

    margin-top: 20px;
    padding: 14px;

    border: none;
    border-radius: 13px;

    background: white;
    color: black;

    font-weight: 700;

    transition: 0.3s ease;
}

.card-ai-btn:hover {
    background: #a45cff;
    color: white;
    box-shadow: 0 10px 35px rgba(155, 92, 255, 0.3);
}

/* =========================
   SECTIONS
========================= */

.section {
    max-width: 1400px;
    margin: auto;

    padding: 100px 6%;
}

.section-title {
    display: flex;
    align-items: end;
    justify-content: space-between;

    margin-bottom: 45px;
}

.small-title {
    display: block;

    color: #a86aff;
    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 1.5px;

    margin-bottom: 10px;
}

.section-title h2 {
    font-size: clamp(34px, 4vw, 55px);
    letter-spacing: -2px;
}

.section-title h2 span {
    color: #9b5cff;
}

.view-all {
    border: none;
    background: transparent;

    color: #a86aff;

    transition: 0.3s ease;
}

.view-all:hover {
    transform: translateX(5px);
}

/* =========================
   SPECIALISTS
========================= */

.specialists-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.specialist-card {
    position: relative;

    padding: 28px;

    border-radius: 24px;

    background: #0d0d11;
    border: 1px solid rgba(255, 255, 255, 0.07);

    overflow: hidden;

    transition: 0.45s ease;
}

.specialist-card::after {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    right: -90px;
    top: -90px;

    border-radius: 50%;

    background: #8b4dff;

    filter: blur(100px);

    opacity: 0;

    transition: 0.5s ease;
}

.specialist-card:hover {
    transform: translateY(-10px);
    border-color: rgba(155, 92, 255, 0.35);

    box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.45),
        0 0 45px rgba(124, 60, 255, 0.08);
}

.specialist-card:hover::after {
    opacity: 0.15;
}

.top-label {
    position: absolute;

    top: 18px;
    right: 18px;

    padding: 7px 11px;

    border-radius: 30px;

    background: rgba(155, 92, 255, 0.1);

    border: 1px solid rgba(155, 92, 255, 0.25);

    color: #b88cff;
    font-size: 12px;
}

.avatar {
    width: 76px;
    height: 76px;

    display: grid;
    place-items: center;

    border-radius: 22px;

    background: linear-gradient(
        135deg,
        #17131f,
        #281742
    );

    border: 1px solid rgba(155, 92, 255, 0.25);

    font-size: 35px;

    margin-bottom: 18px;

    transition: 0.4s ease;
}

.specialist-card:hover .avatar {
    transform: scale(1.08) rotate(3deg);
}

.specialist-card h3 {
    font-size: 20px;
    margin-bottom: 7px;
}

.verified {
    color: #ae83ff;
    font-size: 12px;
    margin-bottom: 15px;
}

.rating {
    display: flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 15px;

    font-weight: 700;
}

.rating span {
    color: #74747d;
    font-size: 12px;
    font-weight: normal;
}

.specialist-card p {
    color: #898992;
    font-size: 14px;

    padding-bottom: 20px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding-top: 20px;
}

.card-footer strong {
    font-size: 14px;
}

.card-footer button {
    border: none;
    background: transparent;

    color: #a86aff;

    transition: 0.3s ease;
}

.card-footer button:hover {
    transform: translateX(5px);
}

/* =========================
   CATEGORIES
========================= */

.center {
    display: block;
    text-align: center;
}

.categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.category {
    min-height: 150px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;

    padding: 25px;

    text-align: left;

    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;

    background: #0c0c10;
    color: white;

    transition: 0.4s ease;
}

.category span {
    font-size: 27px;
    margin-bottom: 15px;
}

.category strong {
    font-size: 17px;
}

.category small {
    margin-top: 5px;
    color: #777780;
}

.category:hover {
    transform: translateY(-7px);

    border-color: rgba(155, 92, 255, 0.35);

    background: linear-gradient(
        145deg,
        #111018,
        #0b0b0f
    );

    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
}

/* =========================
   AI SECTION
========================= */

.ai-section {
    max-width: 1200px;
    margin: 100px auto;

    padding: 90px 8%;

    position: relative;
    overflow: hidden;

    text-align: center;

    border-radius: 35px;

    background:
        radial-gradient(
            circle at center,
            rgba(124, 60, 255, 0.18),
            transparent 55%
        ),
        #0a0a0e;

    border: 1px solid rgba(155, 92, 255, 0.2);

    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.4);
}

.ai-big-icon {
    width: 85px;
    height: 85px;

    display: grid;
    place-items: center;

    margin: 0 auto 25px;

    border-radius: 28px;

    background: rgba(155, 92, 255, 0.1);

    border: 1px solid rgba(155, 92, 255, 0.25);

    font-size: 40px;

    animation: aiFloat 3s ease-in-out infinite;
}

@keyframes aiFloat {
    0%,
    100% {
        transform: translateY(0) rotate(0);
    }

    50% {
        transform: translateY(-8px) rotate(3deg);
    }
}

.ai-section h2 {
    max-width: 750px;

    margin: 0 auto 20px;

    font-size: clamp(35px, 5vw, 58px);

    letter-spacing: -2px;
}

.ai-section h2 span {
    color: #a45cff;
}

.ai-section p {
    max-width: 700px;

    margin: 0 auto 30px;

    color: #85858f;

    line-height: 1.8;
}

/* =========================
   REVIEWS
========================= */

.reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.review-card {
    padding: 27px;

    border-radius: 20px;

    background: #0d0d11;
    border: 1px solid rgba(255, 255, 255, 0.07);

    transition: 0.4s ease;
}

.review-card:hover {
    transform: translateY(-7px);

    border-color: rgba(155, 92, 255, 0.3);

    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
}

.review-stars {
    margin-bottom: 18px;
    letter-spacing: 2px;
}

.review-card p {
    color: #a4a4ad;

    line-height: 1.7;

    margin-bottom: 25px;
}

.review-card strong,
.review-card small {
    display: block;
}

.review-card strong {
    margin-bottom: 5px;
}

.review-card small {
    color: #777780;
}

/* =========================
   FOOTER
========================= */

.footer {
    padding: 60px 6% 30px;

    background: #030304;

    border-top: 1px solid rgba(255, 255, 255, 0.06);

    text-align: center;
}

.footer p {
    max-width: 500px;

    margin: 15px auto;

    color: #777780;

    line-height: 1.6;
}

.footer-links {
    display: flex;
    justify-content: center;
    gap: 25px;

    margin: 25px 0;
}

.footer-links a {
    color: #888892;
    transition: 0.3s ease;
}

.footer-links a:hover {
    color: #a45cff;
}

.copyright {
    color: #4f4f57;
    font-size: 12px;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1000px) {

    .nav {
        gap: 17px;
    }

    .hero {
        grid-template-columns: 1fr;
        gap: 60px;
    }

    .hero-card {
        max-width: 600px;
        width: 100%;
        margin: auto;
    }

    .specialists-grid,
    .categories-grid,
    .reviews-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 760px) {

    .header {
        padding: 0 5%;
    }

    .nav,
    .header-buttons {
        display: none;
    }

    .menu-btn {
        display: block;
    }

    .hero {
        padding: 70px 5%;
        min-height: auto;
    }

    .hero h1 {
        font-size: 48px;
        letter-spacing: -2px;
    }

    .hero p {
        font-size: 15px;
    }

    .hero-stats {
        gap: 25px;
    }

    .section {
        padding: 75px 5%;
    }

    .specialists-grid,
    .categories-grid,
    .reviews-grid {
        grid-template-columns: 1fr;
    }

    .section-title {
        align-items: flex-start;
        gap: 20px;
        flex-direction: column;
    }

    .ai-section {
        margin: 70px 5%;
        padding: 70px 6%;
    }

    .footer-links {
        flex-wrap: wrap;
    }
}

@media (max-width: 480px) {

    .logo {
        font-size: 23px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .primary-btn,
    .ai-btn {
        width: 100%;
    }

    .hero-stats {
        justify-content: space-between;
        gap: 10px;
    }

    .stat strong {
        font-size: 21px;
    }

    .hero-card {
        padding: 22px;
        border-radius: 22px;
    }

    .ai-options {
        grid-template-columns: 1fr;
    }

    .ai-section h2 {
        font-size: 35px;
    }
}
