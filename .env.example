NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Postgres for Prisma (Settings → Database → Connection string)
DATABASE_URL=
DIRECT_URL=
# SMS: "mock" prints OTP codes to the server console
SMS_PROVIDER=mock
